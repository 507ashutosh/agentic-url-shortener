{"seq":26,"at":"2026-10-14T11:30:59.787846Z","runId":"run-20261014-133058-greenfield","type":"decision","stage":"design","data":{"kind":"DECISION","text":"Random 7-character codes from 62 characters with SecureRandom, retry up to 5 times on collision","rationale":"sequential codes would let anyone enumerate other people's links","basedOn":["requirements","plan","impact-analysis"]},"prevHash":"d48b43038eb919e8a0460ac778a332e4703bd77ec0c7892423573c56818d477a","hash":"a5b85590b52fd8e1c058b40a46b9e6df7f54359835766349fa9402fb00193519"}
