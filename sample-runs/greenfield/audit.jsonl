{"seq":28,"at":"2026-10-14T11:30:59.788796Z","runId":"run-20261014-133058-greenfield","type":"decision","stage":"design","data":{"kind":"DECISION","text":"Count clicks with a single UPDATE ... SET click_count = click_count + 1","rationale":"read-modify-write in Java loses clicks under concurrent visits","basedOn":["requirements","plan","impact-analysis"]},"prevHash":"2ead9092d976095f5e6f86118154bb7b5ce3a76ba19bee7ed8db78acb661750f","hash":"33d7b67fdca4e293dfe3a25dff2b9942ef3a6cc70319075d47cb8bd7eac6bc76"}
