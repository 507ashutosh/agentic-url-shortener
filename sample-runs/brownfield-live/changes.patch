+package com.agentic.shortener.config;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.assertj.core.api.Assertions.assertThatThrownBy;
+
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.params.ParameterizedTest;
+import org.junit.jupiter.params.provider.ValueSource;
+import org.springframework.boot.context.properties.EnableConfigurationProperties;
+import org.springframework.boot.test.context.runner.ApplicationContextRunner;
+import org.springframework.context.annotation.Configuration;
+
+class ShortenerPropertiesTest {
+
+    private final ApplicationContextRunner runner = new ApplicationContextRunner()
+            .withUserConfiguration(PropertiesConfig.class);
+
+    @Test
+    void expiryDaysDefaultsTo30WhenUnset() {
+        runner.run(context -> {
+            assertThat(context).hasNotFailed();
+            assertThat(context.getBean(ShortenerProperties.class).link().expiryDays()).isEqualTo(30);
+        });
+    }
+
+    @Test
+    void expiryDaysIsReadFromConfiguration() {
+        runner.withPropertyValues("shortener.link.expiry-days=7").run(context -> {
+            assertThat(context).hasNotFailed();
+            assertThat(context.getBean(ShortenerProperties.class).link().expiryDays()).isEqualTo(7);
+        });
+    }
+
+    @ParameterizedTest
+    @ValueSource(strings = {"0", "-1", "abc"})
+    void invalidExpiryDaysFailsStartupNamingTheProperty(String value) {
+        runner.withPropertyValues("shortener.link.expiry-days=" + value).run(context -> {
+            assertThat(context).hasFailed();
+            assertThat(context.getStartupFailure()).hasStackTraceContaining("shortener.link.expiry-days");
+        });
+    }
+
+    @Test
+    void zeroFailsWithTheDocumentedMessage() {
+        runner.withPropertyValues("shortener.link.expiry-days=0").run(context ->
+                assertThat(context.getStartupFailure())
+                        .rootCause()
+                        .isInstanceOf(IllegalArgumentException.class)
+                        .hasMessage("shortener.link.expiry-days must be at least 1, but was 0"));
+    }
+
+    @Test
+    void linkRecordRejectsValuesBelowOne() {
+        assertThatThrownBy(() -> new ShortenerProperties.Link(-1))
+                .isInstanceOf(IllegalArgumentException.class)
+                .hasMessage("shortener.link.expiry-days must be at least 1, but was -1");
+        assertThat(new ShortenerProperties.Link(1).expiryDays()).isEqualTo(1);
+    }
+
+    @Configuration(proxyBeanMethods = false)
+    @EnableConfigurationProperties(ShortenerProperties.class)
+    static class PropertiesConfig {
+    }
+}
