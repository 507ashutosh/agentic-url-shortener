@@ -0,0 +1,32 @@
+package com.agentic.shortener.service;
+
+import java.time.Duration;
+import java.time.Instant;
+
+import org.springframework.stereotype.Component;
+
+import com.agentic.shortener.config.ShortenerProperties;
+import com.agentic.shortener.domain.UrlMapping;
+
+/**
+ * Decides when a link expires: {@code createdAt + shortener.link.expiry-days}.
+ * Computed on read, so changing the setting re-evaluates every link, old and new.
+ */
+@Component
+public class LinkExpiryPolicy {
+
+    private final Duration expiry;
+
+    public LinkExpiryPolicy(ShortenerProperties properties) {
+        this.expiry = Duration.ofDays(properties.link().expiryDays());
+    }
+
+    public Instant expiresAt(UrlMapping mapping) {
+        return mapping.getCreatedAt().plus(expiry);
+    }
+
+    /** True from the exact expiry instant onwards. */
+    public boolean isExpired(UrlMapping mapping, Instant now) {
+        return !now.isBefore(expiresAt(mapping));
+    }
+}
