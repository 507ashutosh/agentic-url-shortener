+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.content;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.header;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.jsonPath;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.status;
+
+import java.time.Clock;
+import java.time.Duration;
+import java.time.Instant;
+import java.time.ZoneOffset;
+
+import org.junit.jupiter.api.Test;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.boot.test.context.SpringBootTest;
+import org.springframework.boot.webmvc.test.autoconfigure.AutoConfigureMockMvc;
+import org.springframework.http.MediaType;
+import org.springframework.test.context.bean.override.convention.TestBean;
+import org.springframework.test.context.bean.override.mockito.MockitoSpyBean;
+import org.springframework.test.web.servlet.MockMvc;
+
+import com.agentic.shortener.domain.UrlMapping;
+import com.agentic.shortener.domain.UrlMappingRepository;
+import com.agentic.shortener.service.CodeGenerator;
+
+/**
+ * Full application with N = 7 days and the clock fixed at NOW.
+ * The H2 database is shared by all contexts in the JVM, so every seeded code is used once only.
+ */
+@SpringBootTest(properties = {"shortener.link.expiry-days=7", "shortener.rate-limit.requests=1000"})
+@AutoConfigureMockMvc
+class LinkExpiryIntegrationTest {
+
+    private static final Instant NOW = Instant.parse("2026-10-14T10:00:00Z");
+    private static final Duration SEVEN_DAYS = Duration.ofDays(7);
+
+    @TestBean
+    private Clock clock;
+
+    @MockitoSpyBean
+    private CodeGenerator codeGenerator;
+
+    @Autowired
+    private MockMvc mockMvc;
+
+    @Autowired
+    private UrlMappingRepository repository;
+
+    static Clock clock() {
+        return Clock.fixed(NOW, ZoneOffset.UTC);
+    }
+
+    @Test
+    void linkExactlyNDaysOldReturns410WithoutLocation() throws Exception {
+        seed("exp0001", NOW.minus(SEVEN_DAYS));
+
+        expectGone("exp0001");
+    }
+
+    @Test
+    void linkLongPastExpiryReturns410WithoutLocation() throws Exception {
+        seed("exp0002", NOW.minus(Duration.ofDays(30)));
+
+        expectGone("exp0002");
+    }
+
+    @Test
+    void linkOneSecondBeforeExpiryStillRedirects() throws Exception {
+        seed("exp0003", NOW.minus(SEVEN_DAYS).plusSeconds(1));
+
+        mockMvc.perform(get("/exp0003"))
+                .andExpect(status().isFound())
+                .andExpect(header().string("Location", "https://example.com/exp0003"));
+    }
+
+    @Test
+    void expiredLinkIsKeptAndStatsStillWorkWithoutCountingTheClick() throws Exception {
+        seed("exp0004", NOW.minus(SEVEN_DAYS));
+
+        mockMvc.perform(get("/exp0004")).andExpect(status().isGone());
+
+        UrlMapping stored = repository.findByCode("exp0004").orElseThrow();
+        assertThat(stored.getClickCount()).isZero();
+        assertThat(stored.getLastAccessedAt()).isNull();
+
+        mockMvc.perform(get("/stats/exp0004"))
+                .andExpect(status().isOk())
+                .andExpect(jsonPath("$.code").value("exp0004"))
+                .andExpect(jsonPath("$.originalUrl").value("https://example.com/exp0004"))
+                .andExpect(jsonPath("$.clickCount").value(0))
+                .andExpect(jsonPath("$.lastAccessedAt").isEmpty())
+                .andExpect(jsonPath("$.createdAt").value(NOW.minus(SEVEN_DAYS).toString()))
+                .andExpect(jsonPath("$.expiresAt").value(NOW.toString()));
+    }
+
+    @Test
+    void codeOfAnExpiredLinkIsNotReassigned() throws Exception {
+        seed("exp0005", NOW.minus(Duration.ofDays(30)));
+        doReturn("exp0005", "fresh06").when(codeGenerator).next();
+
+        mockMvc.perform(post("/shorten").contentType(MediaType.APPLICATION_JSON)
+                        .content("{\"url\": \"https://example.org/new\"}"))
+                .andExpect(status().isCreated())
+                .andExpect(jsonPath("$.code").value("fresh06"));
+
+        mockMvc.perform(get("/stats/exp0005"))
+                .andExpect(status().isOk())
+                .andExpect(jsonPath("$.originalUrl").value("https://example.com/exp0005"));
+        mockMvc.perform(get("/exp0005")).andExpect(status().isGone());
+    }
+
+    @Test
+    void unknownCodeStillReturns404NotGone() throws Exception {
+        mockMvc.perform(get("/nosuch1"))
+                .andExpect(status().isNotFound())
+                .andExpect(header().doesNotExist("Location"));
+    }
+
+    @Test
+    void shortenAndStatsExposeExpiresAtAsCreatedAtPlusNDays() throws Exception {
+        String expected = NOW.plus(SEVEN_DAYS).toString();
+        assertThat(expected).isEqualTo("2026-10-21T10:00:00Z");
+
+        String body = mockMvc.perform(post("/shorten").contentType(MediaType.APPLICATION_JSON)
+                        .content("{\"url\": \"https://example.com/ac6\"}"))
+                .andExpect(status().isCreated())
+                .andExpect(header().exists("Location"))
+                .andExpect(jsonPath("$.code").isNotEmpty())
+                .andExpect(jsonPath("$.shortUrl").isNotEmpty())
+                .andExpect(jsonPath("$.originalUrl").value("https://example.com/ac6"))
+                .andExpect(jsonPath("$.expiresAt").value(expected))
+                .andReturn().getResponse().getContentAsString();
+        String code = com.jayway.jsonpath.JsonPath.read(body, "$.code");
+
+        mockMvc.perform(get("/stats/" + code))
+                .andExpect(status().isOk())
+                .andExpect(jsonPath("$.createdAt").value(NOW.toString()))
+                .andExpect(jsonPath("$.expiresAt").value(expected));
+    }
+
+    private void expectGone(String code) throws Exception {
+        mockMvc.perform(get("/" + code))
+                .andExpect(status().isGone())
+                .andExpect(header().doesNotExist("Location"))
+                .andExpect(content().contentTypeCompatibleWith(MediaType.APPLICATION_PROBLEM_JSON))
+                .andExpect(jsonPath("$.status").value(410))
+                .andExpect(jsonPath("$.title").value("Gone"))
+                .andExpect(jsonPath("$.detail").value("Short link for code '" + code + "' has expired"))
+                .andExpect(jsonPath("$.instance").value("/" + code));
+    }
+
+    private void seed(String code, Instant createdAt) {
+        repository.save(new UrlMapping(code, "https://example.com/" + code, createdAt));
+    }
+}
