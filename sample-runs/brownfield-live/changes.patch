@@ -0,0 +1,57 @@
+package com.agentic.shortener.service;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+import java.time.Duration;
+import java.time.Instant;
+
+import org.junit.jupiter.api.Test;
+
+import com.agentic.shortener.config.ShortenerProperties;
+import com.agentic.shortener.domain.UrlMapping;
+
+class LinkExpiryPolicyTest {
+
+    private static final Instant T = Instant.parse("2026-10-14T10:00:00Z");
+
+    private final UrlMapping mapping = new UrlMapping("abc1234", "https://example.com", T);
+    private final LinkExpiryPolicy policy = policyWithDays(7);
+
+    @Test
+    void expiresAtIsCreatedAtPlusNDays() {
+        assertThat(policy.expiresAt(mapping)).isEqualTo(Instant.parse("2026-10-21T10:00:00Z"));
+    }
+
+    @Test
+    void notExpiredOneSecondBeforeExpiry() {
+        assertThat(policy.isExpired(mapping, T.plus(Duration.ofDays(7)).minusSeconds(1))).isFalse();
+    }
+
+    @Test
+    void expiredExactlyAtExpiry() {
+        assertThat(policy.isExpired(mapping, T.plus(Duration.ofDays(7)))).isTrue();
+    }
+
+    @Test
+    void expiredAfterExpiry() {
+        assertThat(policy.isExpired(mapping, T.plus(Duration.ofDays(8)))).isTrue();
+    }
+
+    @Test
+    void notExpiredAtCreationTime() {
+        assertThat(policy.isExpired(mapping, T)).isFalse();
+    }
+
+    @Test
+    void changingNChangesExpiryOfTheSameLink() {
+        Instant tenDaysLater = T.plus(Duration.ofDays(10));
+
+        assertThat(policyWithDays(7).isExpired(mapping, tenDaysLater)).isTrue();
+        assertThat(policyWithDays(30).isExpired(mapping, tenDaysLater)).isFalse();
+        assertThat(policyWithDays(30).expiresAt(mapping)).isEqualTo(T.plus(Duration.ofDays(30)));
+    }
+
+    private static LinkExpiryPolicy policyWithDays(int days) {
+        return new LinkExpiryPolicy(new ShortenerProperties(null, null, new ShortenerProperties.Link(days)));
+    }
+}
